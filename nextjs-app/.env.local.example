# ── 資料庫 ─────────────────────────────────────────────────────
# 本機開發：SQLite（留空即可）
# Azure App Service：file:/home/site/db/app.db
DATABASE_URL="file:./dev.db"

# ── OCR 微服務 ──────────────────────────────────────────────────
# 本機開發：http://localhost:8000（若本地跑 Python）
# 部署：Azure App Service URL
OCR_SERVICE_URL="https://tku-mail-ocr.azurewebsites.net"

# ── 上傳目錄 ────────────────────────────────────────────────────
# 本機開發：留空 → 使用 public/uploads（Next.js 靜態服務）
# Azure App Service：/home/site/uploads（持久化磁碟，由 /api/uploads/[filename] serve）
UPLOADS_DIR=

# ── Microsoft Entra ID（MSAL）─────────────────────────────────
# 至 Azure Portal → App registrations 取得
NEXT_PUBLIC_AZURE_CLIENT_ID="your-azure-client-id"
NEXT_PUBLIC_AZURE_TENANT_ID="your-azure-tenant-id"

# ── 管理員設定 ──────────────────────────────────────────────────
# 自動授予 admin 權限的 Email 清單（逗號分隔）
# 系統啟動時自動同步到 AdminUser 資料表
ADMIN_BOOTSTRAP_EMAILS=410410681@o365.tku.edu.tw

# ── 本機開發 bypass（僅 NODE_ENV=development 時生效）─────────
# 設 true 可跳過 MSAL 登入，直接以 LOCAL_ADMIN_EMAIL 身份進入後台
LOCAL_ADMIN_BYPASS=false
LOCAL_ADMIN_EMAIL=dev-admin@example.com
NEXT_PUBLIC_LOCAL_ADMIN_BYPASS=false
NEXT_PUBLIC_LOCAL_ADMIN_EMAIL=dev-admin@example.com

# ── MS Teams Incoming Webhook（選填）───────────────────────────
# 在 Teams 頻道 > 管理連接器 > Incoming Webhook 取得
TEAMS_WEBHOOK_URL=
